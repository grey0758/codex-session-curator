[Unit]
Description=Codex Session Curator slot %i
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/grey/data/apps/codex-session-curator-blue-green/slots/%i/current
Environment=HOST=127.0.0.1
Environment=CODEX_HOME=/home/grey/.codex
Environment=CURATOR_EVALUATION_CONCURRENCY=2
Environment=CURATOR_AUTO_BACKFILL_INTERVAL_MS=60000
Environment=CURATOR_AUTO_BACKFILL_INITIAL_DELAY_MS=10000
Environment=CURATOR_AUTO_BACKFILL_LIMIT=8
Environment=CURATOR_AUTO_BACKFILL_INCLUDE_FAILED=1
Environment=CURATOR_EVALUATION_QUIET_MS=60000
Environment=CURATOR_SESSION_AUDIT_PENDING_GRACE_MS=900000
Environment=CURATOR_REMOTE_EVALUATION_INTERVAL_MS=60000
Environment=CURATOR_REMOTE_EVALUATION_INITIAL_DELAY_MS=15000
Environment=CURATOR_REMOTE_EVALUATION_LIMIT=4
Environment=CURATOR_SESSION_AUDIT_INTERVAL_MS=300000
Environment=CURATOR_SESSION_AUDIT_INITIAL_DELAY_MS=30000
Environment=CURATOR_AI_SEARCH_MODEL=deepseek-v4-flash
Environment=CURATOR_AI_SEARCH_TIMEOUT_MS=12000
Environment=CURATOR_AI_SEARCH_PRIMARY_TIMEOUT_MS=6500
Environment=CURATOR_AI_SEARCH_MAX_TOKENS=500
Environment=CURATOR_AI_SEARCH_CANDIDATE_LIMIT=18
Environment=CURATOR_REMOTE_AGENTS=cnal002=http://127.0.0.1:54179,us002=http://127.0.0.1:54178
Environment=CURATOR_TERMINAL_TRANSPORT=auto
Environment=CURATOR_TERMINAL_TMUX_SOCKET=codex-curator
Environment=CURATOR_TERMINAL_SSH_TARGET_GPL001=curator-localhost
Environment=CURATOR_TERMINAL_SSH_TARGET_CNAL002=cnal002-ts
Environment=CURATOR_TERMINAL_SSH_TARGET_US002=us002-curator-terminal
Environment=CURATOR_TERMINAL_SSH_COMMAND_US002=/home/grey/bin/ssh-1p
Environment=CURATOR_TERMINAL_SSH_HOST_FIRST_US002=1
EnvironmentFile=-/home/grey/.config/codex-session-curator/auth.env
EnvironmentFile=-/home/grey/.config/codex-session-curator/llm.env
EnvironmentFile=-/home/grey/.config/codex-session-curator/remote-workers.env
EnvironmentFile=/home/grey/.config/codex-session-curator/onepassword.env
EnvironmentFile=/home/grey/.config/codex-session-curator/slots/%i.env
ExecStart=/usr/bin/npm run server
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
